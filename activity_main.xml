<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vehicle Service Tracker"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#17365D"
        android:gravity="center"
        android:padding="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage your vehicle maintenance and expenses"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnAddVehicle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Vehicle" />

    <Button
        android:id="@+id/btnAddService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Service Record" />

    <Button
        android:id="@+id/btnHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Service History" />

    <Button
        android:id="@+id/btnVehicles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Vehicles" />

    <Button
        android:id="@+id/btnExpenses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Refresh Total Expenses" />
</LinearLayout>
